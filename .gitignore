# Залежності та збірка
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Секрети — справжні ключі живуть тут і НІКОЛИ не потрапляють у git.
# Шаблон зі списком змінних — у .env.example, він комітиться.
.env
.env.local
.env.*.local

# Артефакти тестів
test-results/
playwright-report/
blob-report/
coverage/

# Системне
.DS_Store
Thumbs.db
*.log

# Лабораторна 3, фабрика задач: сирі теки прогонів — поза git (лише корінь репозиторію, не docs/lab3/runs/);
# відібрані артефакти в docs/lab3/runs/ комітяться разом з agent.log, який інакше відкинув би *.log
/runs/
!docs/lab3/runs/**/agent.log

# УВАГА: тека .agent-log/ НЕ ігнорується навмисно.
# Журнал дій агента — це пакет доказів лабораторної роботи, він має бути
# у git разом із кодом. Якщо у ваш журнал випадково потрапив секрет —
# не видаляйте файл мовчки: перевипустіть ключ і опишіть це в журналі
# автономності. Приховані інциденти — гірші за визнані.
