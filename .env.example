# ---------------------------------------------------------------------------
# ШАБЛОН змінних середовища. Тут — ТІЛЬКИ порожні значення й коментарі.
#
# Справжні ключі клади у .env.local — цей файл у .gitignore і НІКОЛИ не
# потрапляє в git. Ключ, який один раз потрапив у комміт, вважається
# скомпрометованим: його треба відкликати в кабінеті провайдера, а не видаляти
# комміт.
#
# Політика даних курсу: через безкоштовні рівні провайдерів можна пропускати
# лише власний навчальний код і публічні матеріали. Персональні дані, робочі
# репозиторії роботодавця, чужі закриті матеріали — ні.
#
# Після зміни цього файлу перевір, що .env.local має ті самі ключі.
# ---------------------------------------------------------------------------

# --- Хмарні провайдери -----------------------------------------------------

# Anthropic (Claude). Кабінет: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI. Кабінет: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini. Кабінет: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Той самий ключ під назвою, яку читає провайдер AI SDK @ai-sdk/google (крок 09).
GOOGLE_GENERATIVE_AI_API_KEY=

# Модель верифікатора (Лаб2, крок 03): інша родина, ніж Claude, що пише код.
# Порожньо = gemini-3.5-flash-lite (Google, free tier; ключ — GEMINI_API_KEY вище).
VERIFIER_MODEL=

# --- Шлюз до моделей -------------------------------------------------------

# Якщо ходиш до моделей через шлюз (єдина точка обліку витрат і лімітів),
# ключ провайдера в коді не потрібен — потрібен ключ шлюзу.
AI_GATEWAY_API_KEY=
# Базова адреса шлюзу; порожньо = звертаємось до провайдерів напряму.
AI_GATEWAY_BASE_URL=

# OpenRouter (кроки 10–11): ключ https://openrouter.ai/keys — без поповнення рахунку,
# лише :free-моделі з підтримкою tools (supported_parameters у /api/v1/models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Локальний сервер моделей (Ollama) -------------------------------------

# Адреса локального сервера. Типове значення: http://localhost:11434
OLLAMA_BASE_URL=

# Ідентифікатор локальної чат-моделі — те, що показує `ollama list`.
# Порожньо = береться значення за замовчуванням із src/models.ts.
OLLAMA_MODEL=

# Ідентифікатор локальної моделі ембедингів (роль `embed` у src/models.ts).
OLLAMA_EMBED_MODEL=

# --- Трасування (крок 10) --------------------------------------------------

# Langfuse Cloud → проєкт → Settings → API Keys. Секретний ключ — лише тут і у Vercel.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Регіон проєкту: EU — https://cloud.langfuse.com, US — https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
